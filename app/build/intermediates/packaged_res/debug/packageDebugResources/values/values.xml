<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#06B6D4</color>
    <color name="accent_soft">#2206B6D4</color>
    <color name="accent_strong">#0891B2</color>
    <color name="background">#F8FAFC</color>
    <color name="delete_red">#DC2626</color>
    <color name="divider">#E2E8F0</color>
    <color name="fab_color">#F97316</color>
    <color name="placeholder_bg">#E2E8F0</color>
    <color name="primary">#0F172A</color>
    <color name="primary_dark">#020617</color>
    <color name="primary_light">#334155</color>
    <color name="primary_light_alpha">#1A0F172A</color>
    <color name="surface">#FFFFFF</color>
    <color name="text_hint">#64748B</color>
    <color name="text_primary">#0F172A</color>
    <color name="text_secondary">#334155</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">Reporte de Fallas</string>
    <style name="Theme.LabFailureReport" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
    </style>
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.App.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_light</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
</resources>